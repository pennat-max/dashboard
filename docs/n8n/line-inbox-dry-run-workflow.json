{
  "id": "VIGO4ULineProd001",
  "name": "VIGO4U LINE Inbox Production",
  "active": true,
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Production Run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-700, -60]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-700, 160]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "site-url",
              "name": "SITE_URL",
              "type": "string",
              "value": "https://vigo4u-operations.pennat.chatgpt.site"
            },
            {
              "id": "active",
              "name": "ACTIVE",
              "type": "boolean",
              "value": true
            },
            {
              "id": "dry-run",
              "name": "DRY_RUN",
              "type": "boolean",
              "value": false
            },
            {
              "id": "auto-save",
              "name": "AUTO_SAVE",
              "type": "boolean",
              "value": true
            },
            {
              "id": "line-reply",
              "name": "LINE_REPLY",
              "type": "boolean",
              "value": true
            },
            {
              "id": "use-ai",
              "name": "USE_AI",
              "type": "boolean",
              "value": true
            },
            {
              "id": "limit",
              "name": "LIMIT",
              "type": "number",
              "value": 20
            },
            {
              "id": "bearer",
              "name": "BEARER_TOKEN_PLACEHOLDER",
              "type": "string",
              "value": "PUT_N8N_WORKER_SECRET_IN_N8N_CREDENTIALS_NOT_HERE"
            }
          ]
        },
        "options": {}
      },
      "id": "runtime-guard",
      "name": "Runtime Guard",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-420, 40]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "active-false",
              "leftValue": "={{ $json.ACTIVE }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "dry-run-false",
              "leftValue": "={{ $json.DRY_RUN }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "auto-save-true",
              "leftValue": "={{ $json.AUTO_SAVE }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "line-reply-true",
              "leftValue": "={{ $json.LINE_REPLY }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "allow-production-run",
      "name": "Allow Production Run",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-160, 40]
    },
    {
      "parameters": {
        "url": "={{ $json.SITE_URL + '/api/n8n/line-inbox/health' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "health-check",
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, -120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "VIGO4U Site Bearer Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Runtime Guard').item.json.SITE_URL + '/api/n8n/line-inbox/analyze-pending' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { limit: $('Runtime Guard').item.json.LIMIT, use_ai: $('Runtime Guard').item.json.USE_AI } }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "analyze-pending",
      "name": "Analyze Pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, -120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "VIGO4U Site Bearer Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "url": "={{ $('Runtime Guard').item.json.SITE_URL + '/api/n8n/line-inbox/pending-queue?analyze_status=all&limit=50' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "read-queue",
      "name": "Read Queue Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "VIGO4U Site Bearer Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Runtime Guard').item.json.SITE_URL + '/api/n8n/line-inbox/replay-errors' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { limit: 10, dry_run: true } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "inspect-errors",
      "name": "Inspect Errors Safely",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, -120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER",
          "name": "VIGO4U Site Bearer Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "blocked",
              "name": "blocked_reason",
              "type": "string",
              "value": "Workflow guard blocked execution. Production requires ACTIVE=true, DRY_RUN=false, AUTO_SAVE=true, LINE_REPLY=true, and USE_AI=true."
            }
          ]
        },
        "options": {}
      },
      "id": "blocked-output",
      "name": "Blocked Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [120, 180]
    }
  ],
  "connections": {
    "Manual Production Run": {
      "main": [
        [
          {
            "node": "Runtime Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Every Minute": {
      "main": [
        [
          {
            "node": "Runtime Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Runtime Guard": {
      "main": [
        [
          {
            "node": "Allow Production Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Allow Production Run": {
      "main": [
        [
          {
            "node": "Health Check",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Blocked Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health Check": {
      "main": [
        [
          {
            "node": "Analyze Pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Pending": {
      "main": [
        [
          {
            "node": "Read Queue Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Queue Summary": {
      "main": [
        [
          {
            "node": "Inspect Errors Safely",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "production-template-v1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "vigo4u": {
      "active": true,
      "dry_run": false,
      "auto_save": true,
      "line_reply": true,
      "use_ai": true,
      "schedule_minutes": 1
    }
  }
}
